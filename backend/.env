# ============================================================
#  DENTALL — environment variables
#  DO NOT commit this file. It is already in .gitignore.
# ============================================================

# ── Razorpay ────────────────────────────────────────────────
# Paste the Key ID and Key Secret from your Razorpay dashboard.
# Test keys start with rzp_test_  |  Live keys start with rzp_live_
RAZORPAY_KEY_ID=rzp_live_TGQTcS8h7cx6SX
RAZORPAY_KEY_SECRET=PSMZ7TAPZxpXd7DnINpsZM1J

# Go to Razorpay Dashboard → Settings → Webhooks → create a webhook
# Set the endpoint to:  https://yourdomain.com/api/razorpay-webhook
# Copy the "Webhook Secret" Razorpay generates and paste it here.
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── Database (MySQL) ─────────────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASS=your_mysql_password
DB_NAME=dentall

# ── Email (Gmail — for order receipts) ───────────────────────
# Use a Gmail address and an App Password (not your login password).
# Google Account → Security → 2-Step Verification → App Passwords → generate one.
EMAIL_FROM=yourshop@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# ── Shiprocket ───────────────────────────────────────────────
# Set to true while testing (no real shipments created).
# Set to false in production to create real shipments via Shiprocket.
USE_MOCK_SHIPROCKET=true
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password

# ── Server / deployment ──────────────────────────────────────
NODE_ENV=development
# Your frontend URL — used for CORS. In production set to your real domain.
ALLOWED_ORIGIN=http://localhost:5173
# Your warehouse / pickup pincode (6 digits)
YOUR_PINCODE=600001
# Public URL shown in emails (no trailing slash)
SITE_URL=http://localhost:3000
